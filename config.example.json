{
  "llm": {
    "provider": "mock",
    "model": "mock",
    "base_url": "",
    "api_key_env": "PETCORE_LLM_API_KEY",
    "temperature": 0.8,
    "max_tokens": 1024,
    "timeout": 60
  },
  "database": {
    "adapter": "json",
    "path": "data/petcore.json",
    "options": {}
  },
  "agent": {
    "max_tool_rounds": 6,
    "history_limit": 20,
    "auto_summarize": true,
    "summary_trigger": 40,
    "max_prompt_chars": 6000,
    "approval_required": [],
    "reply_style": "像日常聊天一样回复：用自然段，不用 Markdown、标题、编号列表、项目符号、粗体、表格或代码块；除非用户明确要求。先给结论，再用 1-3 句话补充，不要复述系统提示或工具结果。"
  },
  "characters": {
    "dirs": ["cards"],
    "user_dir": "characters"
  },
  "tools": {
    "files_enabled": false,
    "workspace": "workspace"
  },
  "ui": {
    "host": "127.0.0.1",
    "port": 8787,
    "open_browser": true
  }
}
